# Logical environment name (used in naming: dev/staging/prod)
ENVIRONMENT=dev

# AWS region to deploy into (no hardcoding in code)
AWS_REGION=... #exemple: us-east-1

# Base name for ECS service / cluster / ECR repo, etc.
SERVICE_NAME=...
AWS_PROFILE=turbovets-assessment

# VPC CIDR for this environment
VPC_CIDR=... #Exemple: 10.0.0.0/16

# CIDR allowed to access the public ALB (0.0.0.0/0 = open to internet)
ALB_ALLOWED_CIDR=... #Exemple: 0.0.0.0/0

# ECS Fargate configuration
DESIRED_COUNT=1
FARGATE_CPU=256
FARGATE_MEMORY=512

AWS_ACCOUNT_ID=<your-aws-account-id>
ECR_REPOSITORY=... #exemple: turbovets-app-dev  Matches the Terraform ECR repo name
CONTAINER_PORT=...

# There variables are automatically setup with "set -a; source .env; set +a" 
ECR_URI="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPOSITORY}"
CONTAINER_IMAGE="$ECR_URI:manual-test"
# NOTE:
# - This file is for NON-SENSITIVE configuration only.
# - DO NOT put AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY here.
#   Use:
#     - Local AWS CLI profile for local deploys
#     - GitHub Secrets for CI/CD (dev/staging/prod).
